# macOS metadata
.DS_Store
__MACOSX/
._*

# Editor/IDE
.vscode/
.idea/
node_modules/
coverage/
.playwright-cli/

# Local agent and skill-manager state
/.agent/
/.agents/
/skills-lock.json

# Python caches
__pycache__/
*.py[cod]

# Secrets
.env
.env.*
!.env.example

# Local packaging and generated UI artifacts. GitHub Actions builds the
# Dashboard into dashboard/dist and publishes only a digest-pinned Release asset.
*.zip
*.skill
dist/
build/

# Local eval workspaces
.codex-eval-workspace/
skill-reviewer-workspace/

# Local research, article-authoring, screenshots, videos, and generated demos.
# Keep one maintainer architecture map outside the installable Skill so it does
# not enter model context.
/docs/*
!/docs/architecture.md
/diagrams/
/output/
