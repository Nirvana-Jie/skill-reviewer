flowchart LR
    A["Skill package\nSKILL.md · scripts · references"] --> C["Compiler\nlock · digest · assignments"]
    E["Evaluation authority\nevals.json · profile · baseline · holdout"] --> C
    C --> W1["Candidate worker\nfresh workspace"]
    C --> W2["Baseline worker\nfresh workspace"]
    W1 --> D["Deterministic assertions\nschema · file · exit · exact value"]
    W2 --> D
    D --> S["Blind semantic supplement\nA/B + B/A"]
    S --> G{"Release gate\nall hard gates\n+ no objective regression\n+ material primary gain"}
    G -->|"selection passed"| Q["One-shot opaque audit"]
    G -->|"failed / inconclusive"| R["Reject candidate\nnever becomes parent"]
    Q -->|"passed"| P["Evidence-backed release"]
    Q -->|"failed"| R
    O["Optimizer / proposer\nmay change candidate\nmay suggest new eval"] -. "no write authority" .-> E
    G -. "bounded feedback" .-> O
    C --> V["Read-only Dashboard\nrun · artifact · diff · lineage · gate"]
    D --> V
    S --> V
    G --> V

